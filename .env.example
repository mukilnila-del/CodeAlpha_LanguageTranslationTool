# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Translation Service Configuration
# Primary translation provider: 'libretranslate' or 'auto' (recommended)
# When set to 'auto', the app queries LibreTranslate if configured, and
# seamlessly falls back to reliable translation engines so translations always succeed.
TRANSLATION_PROVIDER=auto

# LibreTranslate Endpoint (Optional API key if using libretranslate.com or private instance)
# For local LibreTranslate: http://localhost:5000
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
